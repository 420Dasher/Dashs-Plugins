<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Name>SpotifyTrackHonorific</Name>
    <Author>Dash + AI</Author>
    <Punchline>Show your Spotify track as an Honorific title.</Punchline>
    <Description>Displays your current Spotify track as an Honorific title, including Spotify local files, configurable formatting, title cleanup, and optional Honorific styling.</Description>
    <Tags>spotify;local-files;honorific;music</Tags>
    <IconUrl>https://raw.githubusercontent.com/420Dasher/Dashs-Plugins/main/SpotifyTrackHonorific/images/icon.png</IconUrl>

    <AssemblyName>SpotifyTrackHonorific</AssemblyName>
    <RootNamespace>SpotifyTrackHonorific</RootNamespace>
    <Product>SpotifyTrackHonorific</Product>
    <AssemblyTitle>SpotifyTrackHonorific</AssemblyTitle>

    <Version>1.0.20.0</Version>
    <AssemblyVersion>1.0.20.0</AssemblyVersion>
    <FileVersion>1.0.20.0</FileVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>