<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>3.0.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyName>AethernetAssist</AssemblyName>
    <RootNamespace>AethernetAssist</RootNamespace>
    <Name>AethernetAssist</Name>
    <Author>Dash + AI</Author>
    <Description>Click supported Aetherytes or Aethernet shards on the map to travel automatically. AethernetAssist handles teleports and walking to nearby crystals when needed. It also provides a compact interface for city and residential Aethernet, housing ward travel, Cosmic Exploration, and same-data-center World Visit.</Description>
    <Punchline>Map-based Aetheryte and Aethernet navigation.</Punchline>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <DalamudApiLevel>15</DalamudApiLevel>
  </PropertyGroup>
</Project>