<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>DashsMarketBoardFork</AssemblyName>
    <RootNamespace>MarketBoardPlugin</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DalamudApiLevel>15</DalamudApiLevel>
    <Authors>Florian "fmauNeko" Maunier</Authors>
    <DocumentationFile>bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).xml</DocumentationFile>
    <DebugType>PdbOnly</DebugType>
    <GenerateFullPaths>true</GenerateFullPaths>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0.0</Version>
    <Company>Florian Maunier</Company>
    <Description>Market board plugin for Dalamud.</Description>
    <Copyright>Copyright (c) Florian Maunier. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT License</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/420Dasher/Dashs-Plugins</PackageProjectUrl>
    <RepositoryUrl>https://github.com/420Dasher/Dashs-Plugins.git</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <DefineConstants Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="stylecop.json" />
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="./DashsMarketBoardFork.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Resources/NotoSans-Medium-NNBSP.otf" />
    <EmbeddedResource Include="Resources/NotoSans-Medium-NNBSP.otf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polly.Core" Version="8.6.5" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>